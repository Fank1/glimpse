msgid "Found %1 image(s)."
msgstr ""

#: main.lua:8881
msgid "Scan failed."
msgstr ""

#: main.lua:8888
msgid "Updates"
msgstr ""

#: main.lua:8892
msgid "Check for updates (v%1)"
msgstr ""

#: main.lua:8897
msgid "Include pre-release versions"
msgstr ""

#: main.lua:8898
msgid ""
"Also offer releases marked as pre-release on GitHub – test builds published "
"before a proper release. Normal update checks never see those."
msgstr ""
