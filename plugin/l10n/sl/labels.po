msgid "Glimpse failed to load its scanner module. Try reinstalling the plugin."
msgstr ""
"Glimpse ni mogel naložiti modula za pregledovanje. Poskusite znova namestiti "
"vtičnik."

msgid ""
"Glimpse works with EPUB, FB2 and MOBI books only (this document format is "
"not supported)."
msgstr ""
"Glimpse deluje samo s knjigami EPUB, FB2 in MOBI (ta oblika dokumenta ni "
"podprta)."

